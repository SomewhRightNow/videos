{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d /home/user/Filmler/.git ] || git clone -q -b workspace --single-branch https://github.com/SomewhRightNow/videos /home/user/Filmler; bash /home/user/Filmler/_sync/bootstrap.sh",
            "timeout": 180,
            "statusMessage": "Syncing shared workspace..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /home/user/Filmler/_sync/live.sh 2>/dev/null || true",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/user/Filmler/_sync/convlog.py 2>/dev/null; bash /home/user/Filmler/_sync/srn_sync.sh push 2>/dev/null || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
